# LLM_PROVIDER — default gemini. Allowed: gemini, anthropic, openai.
LLM_PROVIDER=gemini

# GEMINI_API_KEY — required when LLM_PROVIDER=gemini.
GEMINI_API_KEY=your-gemini-api-key-here

# GEMINI_MODEL — default gemini-2.0-flash.
GEMINI_MODEL=gemini-2.5-flash

# ANTHROPIC_API_KEY — optional; required when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=your-key-here

# ANTHROPIC_MODEL — default claude-haiku-4-5-20251001.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# OPENAI_API_KEY — optional; required when LLM_PROVIDER=openai.
OPENAI_API_KEY=your-key-here

# OPENAI_MODEL — default gpt-4o-mini.
OPENAI_MODEL=gpt-4o-mini

# QDRANT_URL — default http://localhost:6333.
QDRANT_URL=http://localhost:6333

# QDRANT_COLLECTION — default fastapi_docs.
QDRANT_COLLECTION=fastapi_docs

# EMBEDDING_MODEL — default BAAI/bge-small-en-v1.5.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# LOG_LEVEL — default INFO.
LOG_LEVEL=INFO
