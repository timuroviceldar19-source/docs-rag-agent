# LLM_PROVIDER — default gemini. Allowed: gemini, anthropic, openai, groq.
LLM_PROVIDER=gemini

# API_KEY — value clients must send in the X-API-Key header. Default dev-key.
API_KEY=dev-key

# GEMINI_API_KEY — required when LLM_PROVIDER=gemini.
GEMINI_API_KEY=your-gemini-api-key-here

# GEMINI_MODEL — default gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash

# ANTHROPIC_API_KEY — optional; required when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=your-key-here

# ANTHROPIC_MODEL — default claude-haiku-4-5-20251001.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# OPENAI_API_KEY — optional; required when LLM_PROVIDER=openai.
OPENAI_API_KEY=your-key-here

# OPENAI_MODEL — default gpt-4o-mini.
OPENAI_MODEL=gpt-4o-mini

# GROQ_API_KEY — optional; required when LLM_PROVIDER=groq.
GROQ_API_KEY=your-key-here

# GROQ_MODEL — default llama-3.3-70b-versatile.
GROQ_MODEL=llama-3.3-70b-versatile

# QDRANT_URL — default http://localhost:6333.
QDRANT_URL=http://localhost:6333

# QDRANT_COLLECTION — default fastapi_docs.
QDRANT_COLLECTION=fastapi_docs

# EMBEDDING_MODEL — default BAAI/bge-small-en-v1.5.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# HYBRID_ENABLED — toggle hybrid retrieval (dense + BM25 + RRF fusion).
# Switching this on/off requires dropping and re-ingesting the collection
# (the on-disk vector layout differs). Default true.
HYBRID_ENABLED=true

# SPARSE_MODEL — fastembed sparse model used for the BM25 leg. Default Qdrant/bm25.
SPARSE_MODEL=Qdrant/bm25

# HYBRID_FETCH_K — per-leg (dense, sparse) candidates pulled before RRF. Default 50.
HYBRID_FETCH_K=50

# RERANK_ENABLED — toggle two-stage retrieval. Default true.
RERANK_ENABLED=true

# RERANK_MODEL — cross-encoder used by the reranker. Default BAAI/bge-reranker-base.
RERANK_MODEL=BAAI/bge-reranker-base

# RERANK_FETCH_K — over-fetch size from Qdrant before reranking down to top_k. Default 20.
RERANK_FETCH_K=20

# LOG_LEVEL — default INFO.
LOG_LEVEL=INFO
